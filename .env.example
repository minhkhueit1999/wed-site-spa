# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# --- Cơ sở dữ liệu ---
DATABASE_URL="file:./dev.db"

# --- Xác thực (Auth.js) ---
# Tạo chuỗi ngẫu nhiên dài (ví dụ: npx auth secret hoặc openssl rand -base64 32)
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# --- AI / RAG ---
# gemini | mock   (mock = bản giả tất định, không cần khóa, dùng cho test/offline)
LLM_PROVIDER="mock"
EMBEDDING_PROVIDER="hash"   # gemini | hash
GEMINI_API_KEY=""
# Tên model: tra tài liệu nhà cung cấp/context7 để lấy tên hiện hành, không đoán
LLM_MODEL=""
EMBEDDING_MODEL=""

RAG_TOP_K="5"
RAG_MIN_SCORE="0.35"
RAG_MAX_QUESTION_CHARS="500"
ASSISTANT_RATE_LIMIT_PER_MIN="10"
